# Optional: run the checks on every push, so a broken change is visible on GitHub even before a server tries it.
# (The server tests every new version itself before switching, so this is a second line of defence.)
# To use: copy to .github/workflows/ci.yml
name: ci
on:
  push:
  pull_request:
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 22 }
      - uses: actions/setup-python@v5
        with: { python-version: '3.12' }
      - run: node --test tests/unit/*.test.js
      - run: python3 serve.py --selftest
