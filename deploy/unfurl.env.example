# Settings for the Unfurl server. install.sh copies this to /etc/unfurl/unfurl.env (readable by root and the
# unfurl user only). Docker users: copy it to deploy/unfurl.env.
# After changing it:  systemctl restart unfurl   (or: docker compose up -d)
#
# Format: NAME=value, one per line. No spaces around "=", no comments on the same line as a value,
# and avoid spaces and # inside values.

# ---- where updates come from (the repository and branch the server follows)
# Private repository? Use a read-only "deploy key" (SSH url) or a fine-grained token with read access:
#   UNFURL_REPO_URL=git@github.com:you/stretching-app.git
#   UNFURL_REPO_URL=https://x-access-token:TOKEN@github.com/you/stretching-app.git
UNFURL_REPO_URL=
# The branch to follow. This repository currently has only claude/sharp-cray-hko5xu (no main).
UNFURL_BRANCH=claude/sharp-cray-hko5xu
# Seconds between update checks; 0 = never update by itself.
UNFURL_UPDATE_INTERVAL=60

# ---- how people reach it
# The ADDRESS the server listens on (one address, not names): 127.0.0.1 if a reverse proxy on this machine is the
# only way in, 0.0.0.0 otherwise. The names people type are NOT put here but in UNFURL_ALLOWED_HOSTS below.
UNFURL_HOST=0.0.0.0
# 80 = no port to type in addresses (http://unfurl.internal/). Direct (non-Docker) installs only; with Docker the port
# people use is set in docker-compose.yml. Keep 8765 behind a reverse proxy.
UNFURL_PORT=8765
# The name(s) people type in the browser, comma-separated, e.g. unfurl.internal,10.0.0.5
UNFURL_ALLOWED_HOSTS=

# ---- who may use it (required whenever UNFURL_HOST is not 127.0.0.1)
# One shared login:
UNFURL_AUTH=
# Or several people, each with their own library: a file with one "name:password" per line.
#   UNFURL_USERS_FILE=/etc/unfurl/users.txt
# Passwords can be stored hashed instead of plain (recommended: this file is readable by the service account):
#   python3 serve.py --hash-password     (prints something like pbkdf2-sha256:200000:...)
# A password must not be empty. Avoid spaces, # and $ in plain passwords (docker compose treats $ specially).
# Already have a login proxy / SSO in front?  Name the header it sets, e.g.
#   UNFURL_TRUST_PROXY_USER=X-Forwarded-User
# That header is believed ONLY for requests that come from the proxy. List the proxy's own address, as narrowly
# as you can (a single machine, not your whole network, or anyone on it could pose as any user):
#   UNFURL_PROXY_IPS=10.0.0.5/32
# And, better still, have the proxy add a secret header (X-Unfurl-Proxy-Secret) that only it knows:
#   UNFURL_PROXY_SECRET=a-long-random-string

# ---- a YouTube key kept on the server, so nobody has to make their own (optional)
#   UNFURL_YOUTUBE_KEY=AIza...
#   UNFURL_YOUTUBE_KEY_FILE=/etc/unfurl/youtube.key
# Each person's daily share of the key's 10,000 free units:
#   UNFURL_USER_DAILY_UNITS=3000

# ---- advanced
# Seconds a new version gets to come up healthy before it is rolled back:
#   UNFURL_HEALTH_TIMEOUT=30
#   UNFURL_KEEP_RELEASES=5
# How often open pages check whether a new version is live:
#   UNFURL_POLL_SECONDS=60
